# CipherOps AI Environment Variables Configuration

# Server
PORT=4000
NODE_ENV=development

# Database (PostgreSQL with pgvector)
DATABASE_URL="postgresql://cipherops:cipherops_secret_password@localhost:5432/cipherops_db?schema=public"

# Security & Authentication
JWT_SECRET="cipherops_super_secure_jwt_secret_key_2026_dev"
JWT_REFRESH_SECRET="cipherops_refresh_token_secret_key_2026"
JWT_EXPIRES_IN="8h"
JWT_REFRESH_EXPIRES_IN="7d"

# AI Provider Configuration
# Options: 'MOCK' (offline zero-dependency grounder), 'OPENAI', 'GEMINI', 'OLLAMA'
AI_PROVIDER=MOCK
AI_API_KEY=""
AI_MODEL=mock-gpt4-investigator

# Storage & Uploads
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=25

# Rate Limiting & Account Security
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
