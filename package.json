{
  "name": "cipherops-ai-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "CipherOps AI — Intelligent Criminal Records & Investigation Management System",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "start": "npm --workspace=backend run start",
    "dev:backend": "npm --workspace=backend run dev",
    "dev:frontend": "npm --workspace=frontend run dev",
    "build": "npm --workspace=backend run build && npm --workspace=frontend run build",
    "test": "npm --workspace=backend test && npm --workspace=frontend test",
    "seed": "npm --workspace=backend run seed"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "cloudinary": "^2.11.0",
    "multer": "^2.5.0"
  }
}
